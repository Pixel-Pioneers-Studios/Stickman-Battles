# ── Dependencies ─────────────────────────────────────────────────────────────
# Render's buildCommand is `npm ci`, which wipes and reinstalls node_modules on
# every deploy — committing it added ~60MB and 4000 files for nothing.
node_modules/

# ── Runtime data ─────────────────────────────────────────────────────────────
# storage.js creates data.db on first run; it holds live ban records, so a
# committed copy just fights whatever the server writes.
data.db
data.db-shm
data.db-wal

# ── Secrets / local config ───────────────────────────────────────────────────
.env
SMB.env
.claude

# ── Generated output ─────────────────────────────────────────────────────────
# tools/tour/tour-capture.js regenerates these frames on demand.
tools/tour/tour-frames/
# tools/voice/render.py's Python env and the 350MB Kokoro model it downloads.
tools/voice/.venv/
tools/voice/model/

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
*.mov

# ── Not for the public repo ──────────────────────────────────────────────────
CLAUDE.md
docs/README_ANALYSIS.md
dist/

# ── Brain trainer ────────────────────────────────────────────────────────────
# PyTorch venv for tools/brain/torch_ppo.py (see tools/brain/torch_client.js).
tools/brain/.venv/
__pycache__/

# ── Rendered video + local experiment data ───────────────────────────────────
# Films, Shorts and screen recordings run 100MB-1.2GB each (over GitHub's limit).
*.mp4
# Brain training runs and level-tester results: ~3GB, regenerated by tools/brain
# and tools/level-tester.js. Files already tracked in these folders stay tracked.
data/level-test/
data/boss-bench/
data/brain-*/
data/brain-startup.nohup
data/brain/*-cand.json
data/brain/ship-*.json
data/brain/*-clone.json
data/brain/latest.js
